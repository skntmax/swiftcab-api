# Per-service identity only.
# Shared Redis / Kafka / Consul connection defaults live in:
#   ../env/shared.mesh.dev.env
#
# Merge these into .env.development (do not re-copy REDIS_HOST / KAFKA_HOST).

PORT=5000
CONSUL_SERVICE_NAME=swc-api
KAFKA_CLIENT_ID=swc-api
# Optional overrides:
# KAFKA_ENABLED=false
# MEDIUM_PUBLIC_BASE_URL=http://127.0.0.1:9000/medium
